{
	"name": "virtual-tour-svelte-app",
	"version": "2.1.0",
	"private": true,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --ignore-path .gitignore --check --plugin-search-dir=. . && eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --ignore-path .gitignore --write --plugin-search-dir=. ."
	},
	"dependencies": {
		"@photo-sphere-viewer/autorotate-plugin": "^5.15.1",
		"@photo-sphere-viewer/compass-plugin": "^5.15.1",
		"@photo-sphere-viewer/core": "^5.15.1",
		"@photo-sphere-viewer/gallery-plugin": "^5.15.1",
		"@photo-sphere-viewer/virtual-tour-plugin": "^5.15.1",
		"@sanity/client": "^7.22.0",
		"@tailwindcss/vite": "^4.3.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@portabletext/types": "^4.0.2",
		"@sanity/types": "^6.16.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.6.2",
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"prettier": "^3.9.8",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.4.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.1"
	},
	"type": "module",
	"overrides": {
		"cookie": "^0.7.2"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
