{
  "name": "virtual-tour-studio",
  "private": true,
  "version": "2.1.0",
  "main": "package.json",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "sanity dev",
    "start": "sanity start",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "deploy-graphql": "sanity graphql deploy",
    "format": "pnpx prettier --write \"**/*.{md,css,js,ts,json}\" \"!node_modules/**\"",
    "lint": "eslint .",
    "typegen": "sanity schema extract --force && sanity typegen generate"
  },
  "keywords": [
    "sanity"
  ],
  "dependencies": {
    "@sanity/dashboard": "^6.0.14",
    "@sanity/vision": "^6.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.16.0",
    "sanity-plugin-dashboard-dad-jokes": "^2.0.0",
    "sanity-plugin-media": "^6.1.1",
    "styled-components": "^6.4.2"
  },
  "devDependencies": {
    "@sanity/eslint-config-studio": "^6.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "eslint": "^9.14.0",
    "prettier": "^3.0.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "smol-toml": "^1.6.1",
    "@module-federation/dts-plugin": {
      "undici": ">=7.28.1 <8",
      "adm-zip": "^0.6.1"
    },
    "typeid-js": {
      "uuid": "^11.1.1"
    }
  },
  "prettier": {
    "semi": false,
    "printWidth": 100,
    "bracketSpacing": false,
    "singleQuote": true
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
